# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — required for /api/mcp and admin API-key creation
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only — AES-256 key for password vault (32 bytes as base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# Optional — external agent runtimes (separate projects / subdomains)
# AGENT_CALL_CONTROL_URL=https://call-control.agents.example.com
