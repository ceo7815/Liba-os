# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Production: the public site URL exactly as users open it (https://your-domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — required for invites, role changes, MCP, finance writes
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only — AES-256 key for password vault (32 bytes as base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# Server-only — OpenAI (social-media images + invoice vendor/amount detection)
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini for text/vision; gpt-image-2 for images)
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# AGENT_CALL_CONTROL_URL=https://call-control.agents.example.com

# Server-only — Voicenter CDR webhook path secret (/api/voicenter/cdr/<token>). Name only.
VOICENTER_CDR_TOKEN=

# Server-only — clock for the agent-run reaper (POST/GET /api/cron/reap-agent-runs).
# Name only. Unset means the route stays closed (503). See docs/agent-reaper.md.
AGENT_REAPER_CRON_SECRET=

# Server-only — sales dashboard (Microsoft Graph + TV kiosk)
# Azure app in the agency tenant: Sites.Selected or Files.Read.All, admin consent
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SALES_EXCEL_DRIVE_ID=
# Either the file item id, or a path inside that drive (e.g. Reports/sales.xlsx)
SALES_EXCEL_ITEM_ID=
# SALES_EXCEL_FILE_PATH=Reports/sales.xlsx
# Work Microsoft 365 email that owns the OneDrive folder (instead of DRIVE_ID)
# SALES_EXCEL_USER=name@company.com
# Long random token for the office TV URL: /sales-tv?token=...
# The local OneDrive watcher uses the same token to push the Excel file.
SALES_TV_KIOSK_TOKEN=
# SALES_DASHBOARD_URL=https://liba.os.beosystem.com
# SALES_EXCEL_LOCAL_PATH=

# Server-only — Google Ads (all spend maps to the «שיחות נכנסות» cube)
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/google-ads/callback
# Scope: https://www.googleapis.com/auth/adwords
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional: skip OAuth UI and use a pre-made refresh token
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# Server-only — Facebook Ads (each campaign is mapped to a cube)
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/facebook-ads/callback
# OAuth scopes requested by the app: ads_read, ads_management, business_management
# APP_ID and APP_SECRET are used to connect and extend a token, not by the daily sync.
# ACCESS_TOKEN, when set, overrides the token stored in facebook_ads_settings.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_AD_ACCOUNT_ID=
FACEBOOK_GRAPH_VERSION=
# Optional extras on top of the built-in allowlist.
# Liba defaults: 917903574641136, 1393650169256796
# Shemesh default: 2542541459538449
FACEBOOK_LIBA_AD_ACCOUNT_IDS=
FACEBOOK_SHEMESH_AD_ACCOUNT_IDS=
GOOGLE_SHEMESH_CUSTOMER_IDS=
# Liba Google default: 6469861321
GOOGLE_LIBA_CUSTOMER_IDS=

# Server-only — Shemesh connectors. Liba ad accounts and the Liba sales file are not reused.
# Leave empty until each vendor confirms API access. Presence alone does not start a sync.
# SHEMESH_INSURANCE_API_URL=
# SHEMESH_INSURANCE_API_KEY=
SHEMESH_FACEBOOK_AD_ACCOUNT_ID=
SHEMESH_FACEBOOK_ACCESS_TOKEN=
# SHEMESH_GOOGLE_ADS_CUSTOMER_ID=
# SHEMESH_GOOGLE_ADS_REFRESH_TOKEN=
# SHEMESH_RIVHIT_API_URL=
# SHEMESH_RIVHIT_API_KEY=
# SHEMESH_GROW_API_URL=
# SHEMESH_GROW_API_KEY=
# Local OneDrive copy of דוח מכירות שמש. Separate from the Liba managers file.
# SHEMESH_EXCEL_LOCAL_PATH=
# SHEMESH_EXCEL_DRIVE_ID=
# SHEMESH_EXCEL_ITEM_ID=

# Server-only — Surense lead sync. Names only; never commit secret values.
# Empty TOKEN_URL, API_BASE, and AUDIENCE keep the defaults in lib/surense/client.ts.
# The token request always sends audience. Default audience is https://api.surense.com.
SURENSE_CLIENT_ID=
SURENSE_CLIENT_SECRET=
SURENSE_TOKEN_URL=
SURENSE_API_BASE=
SURENSE_AUDIENCE=
