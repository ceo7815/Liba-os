# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Production: the public site URL exactly as users open it (https://your-domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — required for invites, role changes, MCP, finance writes
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only — AES-256 key for password vault (32 bytes as base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# Server-only — OpenAI image generation (social-media agent, explicit button only)
OPENAI_API_KEY=
# Optional override (default gpt-image-2, same as social-beo)
# OPENAI_IMAGE_MODEL=gpt-image-2

# AGENT_CALL_CONTROL_URL=https://call-control.agents.example.com

# Server-only — sales dashboard (Microsoft Graph + TV kiosk)
# Azure app in the agency tenant: Sites.Selected or Files.Read.All, admin consent
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SALES_EXCEL_DRIVE_ID=
# Either the file item id, or a path inside that drive (e.g. Reports/sales.xlsx)
SALES_EXCEL_ITEM_ID=
# SALES_EXCEL_FILE_PATH=Reports/sales.xlsx
# Long random token for the office TV URL: /sales-tv?token=...
SALES_TV_KIOSK_TOKEN=
